NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/budgetbox
REDIS_URL=redis://localhost:6379
# For local development this placeholder is accepted; production rejects it. Generate a unique secret.
JWT_SECRET=replace-this-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
BCRYPT_COST=12
FRONTEND_URL=http://localhost:5173
# Set true only when the API is behind one trusted reverse proxy/load balancer.
TRUST_PROXY=false

# Set all SMTP values for email delivery. Development may leave them blank and log reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BudgetBox <no-reply@budgetbox.app>

# Optional Google OAuth Web client credentials. Set both together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional seed-only credentials. Development defaults to demo@budgetbox.app / Demo@12345.
# Production seed requires an explicit email and a unique password of at least 12 characters.
# DEMO_EMAIL=
# DEMO_PASSWORD=
