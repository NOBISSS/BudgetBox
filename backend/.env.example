NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/budgetbox
REDIS_URL=redis://localhost:6379
JWT_SECRET=budgetbox
JWT_EXPIRES_IN=1d
BCRYPT_COST=12
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false
# Gmail example. For another provider, use that provider's SMTP hostname.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=BudgetBox <your-account@gmail.com>
DEMO_EMAIL=demo@budgetbox.app
DEMO_PASSWORD=Demo@12345
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
